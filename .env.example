# ===== Google / YouTube (obtenus avec scripts/get_refresh_token.py) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ===== Claude (IA) : clé sur https://console.anthropic.com =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Décris ta chaîne : l'IA s'en sert pour écrire les titres et les réponses
CHANNEL_DESCRIPTION=Chaîne sur l'entrepreneuriat et l'argent, objectif 1 million d'abonnés.
LANGUAGE=français

# ===== Telegram (optionnel) : pour recevoir les rapports sur ton téléphone =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Planification =====
TIMEZONE=Europe/Paris
# Heures de publication (une vidéo de la file par heure indiquée)
PUBLISH_TIMES=18:00
# public, unlisted ou private
DEFAULT_PRIVACY=public
COMMENT_CHECK_MINUTES=30
MAX_REPLIES_PER_RUN=10
STATS_TIME=09:00

# ===== Modules =====
ENABLE_UPLOAD=true
ENABLE_COMMENTS=true
ENABLE_STATS=true

# Mode test : true = le bot affiche ce qu'il ferait sans rien publier
DRY_RUN=true
